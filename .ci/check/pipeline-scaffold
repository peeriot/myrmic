#!/usr/bin/env bash

# Scaffold a Signal Layer pipeline with `myrmic signal-layer new` and compile it,
# for both the Linux and firmware targets, and scaffold + test a driver and a
# step with `myrmic signal-layer driver`/`step`.
#
# This is the only CI gate that *builds* a generated pipeline. The myrmic-cli
# unit tests assert the scaffold's file contents but never compile it, and the
# one test that does build a scaffold is `#[ignore]`d (it needs the CLI's SDK
# git revision pushed plus credentials). So a scaffold that renders
# non-compiling code -- a missing dependency, a codegen regression, a driver
# path that does not resolve -- passes every other check.
#
# A full build, not `cargo check`: the failures this guards against include link
# errors (e.g. a missing embassy-time backend) that only surface at link time.

set -xeuo pipefail

REPO="$PWD"
MYRMIC="$REPO/target/debug/myrmic"
# The firmware builds with the stable toolchain `myrmic-build` pins. Reading the
# channel out of the constant keeps this from drifting from it.
if [ -z "${CARGO_CHANNEL:-}" ]; then
    CARGO_CHANNEL="$(sed -nE 's/^pub const TOOLCHAIN: &str = "(.+)";$/\1/p' \
        "$REPO/swarm/myrmic-build/src/compile.rs")"
fi
if [ -z "$CARGO_CHANNEL" ]; then
    printf 'could not read the toolchain pin from myrmic-build\n' >&2
    exit 1
fi

# Build the scaffolds into the (cached) workspace target dir so their path
# dependencies reuse crates the other jobs already compiled, rather than a cold
# build in a throwaway tmp dir every run.
export CARGO_TARGET_DIR="$REPO/target"

WORK="$(mktemp -d)"
cleanup() { rm -rf "$WORK"; }
trap cleanup EXIT

# The firmware build needs the pinned toolchain and the riscv target. Install only when absent; components/targets are
# idempotent. Mirrors .ci/check/check so this job does not depend on another
# seeding the toolchain volume first.
printf "\n\n--== Ensure Toolchain ==--\n\n"
rustup toolchain list | grep -q "^${CARGO_CHANNEL}" \
    || rustup toolchain install "$CARGO_CHANNEL" --profile minimal
rustup target add riscv32imac-unknown-none-elf --toolchain "$CARGO_CHANNEL"

printf "\n\n--== Build myrmic ==--\n\n"
cargo build --bin myrmic

# `--sdk "$REPO"` makes the scaffold resolve the SDK and every driver/step crate
# as path dependencies into this checkout, so the build needs no network or
# credentials (unlike the git-SDK default, which needs the CLI's revision
# pushed).

printf "\n\n--== Linux pipeline: scaffold + build ==--\n\n"
LINUX="$WORK/linux"
"$MYRMIC" signal-layer new "$LINUX" --sdk "$REPO"
# `myrmic build` recognises the scaffold's `[package.metadata.myrmic] pipeline`
# marker and compiles the native tokio binary for the host. A full build links
# it, catching missing-backend link errors a `check` would miss.
"$MYRMIC" build "$LINUX"

printf "\n\n--== Firmware pipeline: scaffold + build ==--\n\n"
FIRMWARE="$WORK/firmware"
"$MYRMIC" signal-layer new --firmware=esp32c6 "$FIRMWARE" --sdk "$REPO"
# `myrmic build` supplies the toolchain + link flags + chip feature the firmware
# needs; the chip comes from the scaffold manifest's default feature.
"$MYRMIC" build "$FIRMWARE"

# The scaffold's `.cargo/config.toml` and build script carry everything a plain
# `cargo build` needs (an IDE, rust-analyzer, a user's own CI), and the image
# must come out with the layout `myrmic build` produces: the segments, which
# are what gets flashed. The symbol and string tables differ with cargo's
# metadata hash and are not part of the image. Same target dir: the differing
# rustflags give the two builds separate artifacts, and the final ELF is read
# before the second build overwrites it.
FIRMWARE_ELF="$CARGO_TARGET_DIR/riscv32imac-unknown-none-elf/release/firmware"
readelf -l --wide "$FIRMWARE_ELF" > "$WORK/myrmic.layout"
( cd "$FIRMWARE" && cargo build --release )
readelf -l --wide "$FIRMWARE_ELF" > "$WORK/cargo.layout"
diff "$WORK/myrmic.layout" "$WORK/cargo.layout"

# A crate trimmed to its one chip must not warn about the other chips' cfgs,
# which `esp_firmware::board!` expands in the crate.
sed -i -E '/^esp32c(5|61) *=/d' "$FIRMWARE/Cargo.toml"
( cd "$FIRMWARE" && cargo build --release 2>&1 | tee "$WORK/trimmed.log" )
if grep -q 'unexpected_cfgs' "$WORK/trimmed.log"; then
    printf 'the firmware scaffold trimmed to one chip warns about unexpected cfgs\n' >&2
    exit 1
fi

printf "\n\n--== Signal Layer modules: scaffold + build ==--\n\n"
MODS="$WORK/mods"
"$MYRMIC" signal-layer driver demo_i2c  --bus i2c --registry-dir "$MODS"
"$MYRMIC" signal-layer driver demo_spi  --bus spi --registry-dir "$MODS"
"$MYRMIC" signal-layer step   demo_step           --registry-dir "$MODS" --sdk "$REPO"
# The scaffolds are standalone crates with a stubbed test suite; `cargo test`
# catches a template that renders non-compiling code.
( cd "$MODS/drivers/demo_i2c" && cargo test )
( cd "$MODS/drivers/demo_spi" && cargo test )
( cd "$MODS/steps/demo_step" && cargo test )

printf "\n\n--== Pipeline and module scaffolds build clean ==--\n\n"

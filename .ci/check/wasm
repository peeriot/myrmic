#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Cells need nightly for -Zbuild-std. Dated rather than floating: `nightly` moves
# on its own, and the set of lints it denies moves with it, so CI and a local run
# stop agreeing on what clean means. The workflow passes the same date.
CARGO_CHANNEL=${CARGO_CHANNEL:-nightly-2026-08-07}

# Cell crates are `cdylib` and pull wasm-only SDK features, so they cannot join
# `default-members` and are invisible to Check Code. This job is their only linter.
#
# `CELL_ROOTS` is overridable so the coverage self-test can point the listing at a
# synthetic tree. Deliberate word splitting: it is a space-separated list.
CELL_ROOTS=${CELL_ROOTS:-"${REPO_ROOT}/tests/fixtures ${REPO_ROOT}/benchmarks/warehouse/cells"}

names=()
for root in $CELL_ROOTS; do
    for dir in "$root"/*/; do
        [ -f "${dir}.ci-skip-wasm-build" ] && continue
        [ -f "${dir}Cargo.toml" ] || continue
        names+=("$(basename "$dir")")
    done
done

# Fail closed: a rename or a moved fixture tree would otherwise leave this job
# green having linted nothing.
if [ ${#names[@]} -eq 0 ]; then
    printf 'no cell packages found under: %s\n' "$CELL_ROOTS" >&2
    exit 1
fi

# The coverage check reads the same list rather than re-deriving the glob.
if [ "${1:-}" = "--list" ]; then
    printf '%s\n' "${names[@]}"
    exit 0
fi

pkgs=()
for name in "${names[@]}"; do
    pkgs+=(-p "$name")
done

rustup toolchain list | grep -q "^${CARGO_CHANNEL}" \
    || rustup toolchain install "$CARGO_CHANNEL" --profile minimal
rustup component add clippy rust-src --toolchain "$CARGO_CHANNEL"
rustup target add wasm32-unknown-unknown --toolchain "$CARGO_CHANNEL"

cargo "+$CARGO_CHANNEL" clippy \
    --manifest-path "${REPO_ROOT}/Cargo.toml" \
    --profile wasm-release \
    --target wasm32-unknown-unknown \
    -Zbuild-std=core,alloc,compiler_builtins \
    "${pkgs[@]}" \
    -- \
        --deny "warnings"

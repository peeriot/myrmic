//! A Linux Signal Layer pipeline.
//!
//! The pipeline is described in manifest.yml (the devices) and pipeline.yml
//! (the sources, steps and taps), and generated at build time. This process
//! runs the pipeline and serves its taps and outlets over the signal-layer IPC
//! socket.

mod pipeline_config {
    #![allow(unused_imports, dead_code, unused_variables)]
    include!(concat!(env!("OUT_DIR"), "/pipeline.rs"));
}

#[tokio::main]
async fn main() {
    env_logger::Builder::from_env(env_logger::Env::default().default_filter_or("info")).init();

    // Set up outlets, then taps: setup_outlet_registry parks the outlet store
    // that setup_tap_registry hands to the IPC server it starts.
    pipeline_config::setup_outlet_registry();
    pipeline_config::setup_tap_registry();
    pipeline_config::spawn_sources(&(), pipeline_config::BoardPeripherals::new());

    println!("Pipeline `{{name}}` running. Press Ctrl-C to stop.");
    tokio::signal::ctrl_c()
        .await
        .expect("failed to listen for ctrl-c");
}
